# Ignore everything in this repository by default.
*

# Keep this policy file trackable so the allowlist can be enforced.
!/.gitignore

# Allow Markdown specifications anywhere under spec/.
!/spec/
!/spec/**/
!/spec/**/*.md

# Allow Markdown variants anywhere under variants/.
!/variants/
!/variants/**/
!/variants/**/*.md

# Allow Markdown writing rules anywhere under writing-rules/.
!/writing-rules/
!/writing-rules/**/
!/writing-rules/**/*.md

# Project skills (Codex + Grok). Claude Code is not mirrored for now.
!/.agents/
!/.agents/skills/
!/.agents/skills/**
